# ---- Public URL of the app (Caddy serves web at / and proxies /api) ----
DOMAIN=books.example.com
PUBLIC_URL=https://books.example.com
# Only when another web server on the host (Apache, nginx) already owns ports 80/443 and
# proxies to Caddy: DOMAIN=http://books.example.com, local ports, and trust that proxy.
# HTTP_PORT=127.0.0.1:8090
# HTTPS_PORT=127.0.0.1:8453
# TRUSTED_PROXIES=private_ranges

# ---- Postgres ----
POSTGRES_USER=readsync
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=readsync
# Used by the API. In docker-compose the host is "postgres".
DATABASE_URL=postgres://readsync:change-me-to-a-long-random-string@postgres:5432/readsync

# ---- Auth (Better Auth) ----
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
# Optional: Google sign-in. Leave empty to hide the Google button.
# Authorized redirect URI in Google Cloud Console: ${PUBLIC_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to "false" to stop new sign-ups once your accounts exist.
ALLOW_SIGNUP=true
# Require a confirmed email before a new account can sign in. Needs SMTP (below), or nobody
# could verify. Off by default.
REQUIRE_EMAIL_VERIFICATION=false

# ---- Storage ----
STORAGE_DIR=/data
# Max size of a single uploaded file, in megabytes
MAX_UPLOAD_MB=200
# Storage limit per account, in megabytes (books in the library, including copies
# added from share links or the public library). Administrators are unlimited.
UPLOAD_QUOTA_MB=2048

# ---- Object storage (optional) ----
# "local" (default) keeps books in STORAGE_DIR. "s3" uses any S3-compatible bucket
# (AWS S3, Garage, MinIO, Cloudflare R2...); STORAGE_DIR then only holds temp uploads.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=readsync
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Garage and MinIO need path-style URLs; set false for virtual-hosted style.
S3_FORCE_PATH_STYLE=true

# ---- Backups (the "backup" service) ----
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_HOURS=24

# ---- Logs ----
# info (default in production), debug, warn or error. README → Logs.
# LOG_LEVEL=info

# ---- Email (optional) ----
# Sends the welcome and "Forgot password?" emails (README → Email). Without it the reset
# option is hidden in production (in development emails are printed to the API log instead).
# Example (Resend): smtps://resend:<api key>@smtp.resend.com:465
SMTP_URL=
MAIL_FROM=BookRaven <no-reply@books.example.com>

# ---- Dictionary and translation of selected text (optional) ----
# Selected words and passages are sent to these services. Set to "none" to turn off.
DICTIONARY_PROVIDER=wiktionary
# "mymemory" (free, daily limit), "libretranslate" (self-host it for privacy) or "none".
# Chrome's built-in on-device translator is used first when the browser has it.
TRANSLATE_PROVIDER=mymemory
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
# Optional: raises MyMemory's free daily limit.
MYMEMORY_EMAIL=

# ---- Administrators ----
# Comma-separated emails. Administrators have unlimited storage and can remove any
# book from the public library. Create these accounts yourself right after the first
# start (or keep ALLOW_SIGNUP=false), so nobody else can register these addresses.
ADMIN_EMAILS=
