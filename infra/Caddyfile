{
	servers {
		# Proxies whose X-Forwarded-For / -Proto headers are believed. Set TRUSTED_PROXIES=private_ranges
		# when another web server on the host (Apache, nginx) proxies to this Caddy.
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
	}
}

{$DOMAIN} {
	encode zstd gzip

	# API (auth, books, files, progress, SSE), OPDS catalog and KOReader sync
	@api path /api/* /opds /opds/* /kosync/*
	handle @api {
		reverse_proxy api:3000 {
			# Server-Sent Events must not be buffered
			flush_interval -1
			# While a deploy restarts the API, requests wait for it (up to 15 s) instead of failing with 502
			lb_try_duration 15s
			lb_try_interval 250ms
		}
	}

	# Android app: APK, live-update bundles and android.json, uploaded by the Deploy workflow
	# into ./downloads on the host. The app (served from https://localhost) reads android.json.
	handle /downloads/* {
		root * /var/www
		@release path /downloads/android.json /downloads/bookraven.apk
		header @release Cache-Control "no-cache"
		header /downloads/android.json Access-Control-Allow-Origin "*"
		@apk path *.apk
		header @apk Content-Type "application/vnd.android.package-archive"
		file_server
	}

	# Static frontend (SPA)
	handle {
		root * /srv
		try_files {path} /index.html
		# .br/.gz copies made when the image is built (apps/web/scripts/precompress.mjs)
		file_server {
			precompressed br gzip
		}

		# Hashed file names never change, so they are cached for good. Everything else (index.html,
		# which every app route falls back to, sw.js, manifest.webmanifest, icons) is revalidated
		# on each use, so a deploy reaches browsers at once.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@revalidate not path /assets/*
		header @revalidate Cache-Control "no-cache"
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# A book's own scripts can't run in the reader (the iframe is sandboxed without
		# allow-scripts), and this policy is a second line: the app only runs its own bundled
		# scripts. 'wasm-unsafe-eval' is for the 7-Zip/pdf.js WebAssembly; blob: covers the
		# reader iframes, the comic worker and generated images.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; child-src blob:; frame-src blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; manifest-src 'self'"
		-Server
	}
}
